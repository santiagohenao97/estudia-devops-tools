# Node template. Adjust: Node version, start command, health route.
# If you compile (TypeScript, frontend), add a build stage.
FROM node:22-alpine

ARG APP_VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${REVISION}"
ENV APP_VERSION=${APP_VERSION} \
    NODE_ENV=production \
    PORT=3000

WORKDIR /srv

# Dependencies first (npm ci honors package-lock.json and fails if it does not match).
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# The official image already ships an unprivileged "node" user.
RUN mkdir /data && chown node /data
COPY --chown=node . .
USER node
VOLUME /data
EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD node -e "fetch('http://localhost:'+process.env.PORT+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "src/index.js"]
