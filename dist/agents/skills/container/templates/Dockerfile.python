# Python template. Adjust: Python version, dependency file, entry module, health route.
FROM python:3.12-slim

ARG APP_VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${REVISION}"
ENV APP_VERSION=${APP_VERSION} \
    PORT=8000 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /srv

# Dependencies first: this layer is cached until requirements.txt changes.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Unprivileged user; /data is the only writable path (volume).
RUN useradd --system --uid 10001 app && mkdir /data && chown app /data

COPY app ./app
USER app
VOLUME /data
EXPOSE 8000

# Checked by whoever orchestrates the container. Uses Python because the slim image has no curl.
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD python -c "import os,urllib.request as u; u.urlopen('http://localhost:%s/health' % os.environ['PORT'], timeout=2)"

CMD ["python", "-m", "app.main"]
