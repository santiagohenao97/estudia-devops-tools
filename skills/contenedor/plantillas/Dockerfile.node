# Plantilla Node. Ajusta: versión, comando de arranque, ruta de salud. Si compilas (TypeScript, frontend), usa una etapa de build.
FROM node:22-alpine

ARG APP_VERSION=dev
ARG REVISION=desconocida
LABEL org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${REVISION}"
ENV APP_VERSION=${APP_VERSION} \
    NODE_ENV=production \
    PORT=3000

WORKDIR /srv

# Primero las dependencias (npm ci respeta package-lock.json y falla si no coincide).
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# La imagen oficial ya trae el usuario "node" (sin privilegios).
RUN mkdir /data && chown node /data
COPY --chown=node . .
USER node
VOLUME /data
EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD node -e "fetch('http://localhost:'+process.env.PORT+'/salud').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "src/index.js"]
