# Plantilla Python. Ajusta: versión, archivo de dependencias, módulo de arranque, ruta de salud.
FROM python:3.12-slim

ARG APP_VERSION=dev
ARG REVISION=desconocida
LABEL org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${REVISION}"
ENV APP_VERSION=${APP_VERSION} \
    PORT=8000 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /srv

# Primero las dependencias: esta capa se reutiliza mientras requirements.txt no cambie.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Usuario sin privilegios; /data es el único lugar donde se escribe (volumen).
RUN useradd --system --uid 10001 app && mkdir /data && chown app /data

COPY app ./app
USER app
VOLUME /data
EXPOSE 8000

# La salud la comprueba quien orquesta el contenedor. Usa Python porque la imagen slim no trae curl.
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD python -c "import os,urllib.request as u; u.urlopen('http://localhost:%s/salud' % os.environ['PORT'], timeout=2)"

CMD ["python", "-m", "app.main"]
